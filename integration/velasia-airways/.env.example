# Copy to integration/velasia-airways/.env to override. Every value has a working default.

# Path to the Velasia Airways checkout (read-only build context). Relative to this directory.
# VELASIA_SRC=../../../velasia-airways

# Host address the storefront port binds to. 127.0.0.1 = this machine only.
# NEXTRS_HTTP_BIND=127.0.0.1

# Canonical origin: baked into sitemap/robots/metadata at build time and checked at runtime.
# Change it only together with the URL you open (Server Actions check the Origin).
# SITE_URL=http://localhost:3000

# Pin "today" (YYYY-MM-DD, Asia/Manila) for API and storefront together. Unset = real date.
# Needs a rebuild (--build): destination pages are prerendered at build time.
# VELASIA_TODAY=2026-12-01

# NextRS runtime
# NEXTRS_ISOLATES=2
# NEXTRS_LOG_FORMAT=text        # or json
# RUST_LOG=nextrs=info           # nextrs=debug for per-request detail
# RETAILING_API_TIMEOUT_MS=5000

# Retailing API (passed to Velasia's API container only). Production defaults apply otherwise:
# every simulated payment is approved and no outcome picker is shown at checkout.
# Show the "Simulated outcome" picker (Approve / Decline / Time out / Pending) for manual tests
# of failed payments. The API logs a warning; no rebuild needed (`up -d` recreates the API).
# PAYMENT_OUTCOME_CONTROLS=enabled
# Demo account registration (Velasia's switch). compose.yaml enables it for manual testing;
# production's own default is disabled.
# ACCOUNT_REGISTRATION=disabled
# PAYMENT_PROVIDER_DELAY_MS=350
