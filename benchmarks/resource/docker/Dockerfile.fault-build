#
# The fault app's one `next build` (benchmarks/resource/fault-app), as an image that both
# runtime images copy from (Dockerfile.fault-runtime).
#
#   docker build -f benchmarks/resource/docker/Dockerfile.fault-build \
#     -t nextrs-fault-build:s1 benchmarks/resource/fault-app
#
# Needs registry.npmjs.org (npm ci of fault-app/package-lock.json: Next.js 16.4.6, React
# 19.3.1, the versions of fixtures/next-app) and the pinned Node.js image.

ARG NODE_IMAGE=node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d

FROM ${NODE_IMAGE} AS build
ENV CI=true \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund --ignore-scripts --registry=https://registry.npmjs.org/
COPY next.config.ts tsconfig.json ./
COPY app app
# The standalone server with .next/static beside it (no public/ in this app).
RUN npx --no-install next build \
 && test -f .next/standalone/server.js \
 && cp -r .next/static .next/standalone/.next/static \
 && node -p "'next ' + require('/src/node_modules/next/package.json').version" > .next/standalone/next-version.txt \
 && echo "build id: $(cat .next/standalone/.next/BUILD_ID)"
