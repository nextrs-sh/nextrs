{
  "name": "nextrs-runtime-vendor",
  "private": true,
  "description": "Maintained npm implementations of Node.js built-ins, bundled into node-polyfills.js for the embedded runtime",
  "scripts": {
    "build": "esbuild entry.js --bundle --platform=browser --format=iife --legal-comments=inline --outfile=../node-polyfills.js"
  },
  "dependencies": {
    "abort-controller": "file:./shims/abort-controller",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "path-browserify": "1.0.1",
    "process": "file:./shims/process",
    "readable-stream": "4.8.0",
    "string_decoder": "1.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
